{
  "name": "@hearloop/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "../../node_modules/.bin/tsc",
    "dev": "ts-node-dev --respawn src/index.ts",
    "start": "node dist/index.js",
    "test": "node_modules/.bin/jest --runInBand",
    "test:watch": "node_modules/.bin/jest --watch",
    "eval:analysis": "DOTENV_CONFIG_PATH=../../.env ../../node_modules/ts-node-dev/node_modules/.bin/ts-node -r dotenv/config --transpile-only src/eval/run-analysis-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1037.0",
    "@aws-sdk/client-cloudwatch": "3.1037.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-ses": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.0.0",
    "fastify": "^5.8.3",
    "groq-sdk": "^0.9.0",
    "ioredis": "^5.0.0",
    "kysely": "^0.28.17",
    "pg": "^8.0.0",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/pg": "^8.0.0",
    "@types/pino": "^7.0.4",
    "babel-jest": "^29.7.0",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
